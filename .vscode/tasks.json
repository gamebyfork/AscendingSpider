{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-release",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/AscendingSpider/AscendingSpider.csproj",
                "--no-incremental",
                "-c",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}